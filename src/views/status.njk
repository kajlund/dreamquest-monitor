<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>DreamQuest</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<main>
  <header>
    <div><small>DreamQuest</small><h1>Server status</h1></div>
    <span class="status {{ overall }}">{{ overall | upper }}</span>
  </header>

  <section class="metrics">
    <div class="card">
      <small>Uptime</small>
      <b>{{ system.uptime }}</b>
    </div>

    <div class="card">
      <small>CPU Load</small>
      <b>{{ system.load }}</b>
      <span class="metric-detail">{{ system.loadDetail }}</span>
    </div>

    <div class="card">
      <small>Memory</small>
      <b>{{ system.memory }}</b>
    </div>

    <div class="card">
      <small>Temperature</small>
      <b>{{ system.temperature }}</b>
    </div>
</section>

  <h2>Storage</h2>
  <section class="grid">
    {% for x in storage %}<div class="card row"><b>{{ x.label }}</b><span class="status {{x.status}}">{{x.message}}</span></div>{% endfor %}
  </section>

  <h2>Services</h2>
  <section class="grid">
    {% for x in services %}<div class="card row"><b>{{x.label}}</b><span class="status {{x.status}}">{{x.message}}</span></div>{% endfor %}
  </section>

  <h2>Applications</h2>

  <section class="grid app-grid">
    {% for app in apps %}
      <a class="card app-card" href="{{ app.publicUrl }}">
        <div class="app-card-top">
          <div>
            <strong>{{ app.name }}</strong>
            <span class="app-description">{{ app.description }}</span>
          </div>

          <span class="status {{ app.status }}">
            {{ 'ONLINE' if app.status == 'ok' else 'OFFLINE' }}
          </span>
        </div>

        <span class="open-app">Open →</span>
      </a>
    {% endfor %}
  </section>

  <h2>Docker</h2>
  <section class="grid">
    {% for x in docker.containers %}<div class="card row"><b>{{x.name}}</b><span class="status {{x.status}}">{{x.state}}</span></div>{% endfor %}
  </section>

  <h2>Backup</h2>
  <div class="card row"><b>Latest backup</b><span class="status {{backup.status}}">{{backup.message}}</span></div>

  <footer>Updated {{updated}}</footer>
</main>
</body>
</html>
