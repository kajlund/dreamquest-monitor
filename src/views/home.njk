<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>DreamQuest</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/vendor/phosphor/regular/style.css">
</head>
<body class="home-page">
<main class="home-shell">
  <header class="home-header">
    <div class="header-top">
      <small class="eyebrow">DreamQuest</small>
      <nav class="page-nav" aria-label="Main navigation">
        <a href="/" class="nav-link active" aria-current="page">Home</a>
        <a href="/status" class="nav-link">Status</a>
      </nav>
    </div>
    <h1>Welcome</h1>
    <p class="intro">Applications and services on DreamQuest.</p>
  </header>

  <section class="home-section">
    <h2 class="home-section-title">Applications</h2>
    <div class="grid app-grid">
      <a class="card home-app-card" href="https://activus.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-chart-line-up"></i></span>
        <span class="home-card-copy"><strong>Activus</strong><span class="app-description">Activity tracking</span></span>
      </a>

      <a class="card home-app-card" href="https://healthz.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-heartbeat"></i></span>
        <span class="home-card-copy"><strong>Healthz</strong><span class="app-description">Health monitoring</span></span>
      </a>

      <a class="card home-app-card" href="https://foodz.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-fork-knife"></i></span>
        <span class="home-card-copy"><strong>Foodz</strong><span class="app-description">Food application</span></span>
      </a>

      <a class="card home-app-card" href="https://proverbs.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-leaf"></i></span>
        <span class="home-card-copy"><strong>Proverbs</strong><span class="app-description">Proverbs apps</span></span>
      </a>

      <a class="card home-app-card" href="https://immich.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-image"></i></span>
        <span class="home-card-copy"><strong>Immich</strong><span class="app-description">Photos</span></span>
      </a>

      <a class="card home-app-card" href="https://jellyfin.dreamquest/">
        <span class="home-card-icon" aria-hidden="true"><i class="ph ph-film-strip"></i></span>
        <span class="home-card-copy"><strong>Jellyfin</strong><span class="app-description">Movies and media</span></span>
      </a>
    </div>
  </section>

  <section class="home-section">
    <h2 class="home-section-title">Today</h2>
    <div class="grid widgets">
      <article class="card widget-card quote-widget">
        <div class="widget-header">
          <i class="ph ph-quotes" aria-hidden="true"></i>
          <span class="widget-label">Quote of the day</span>
        </div>
        <blockquote class="quote-content">{{ quote.text if quote.text else '"A journey of a thousand miles begins with a single step."' }}</blockquote>
        <cite class="quote-author">— {{ quote.author if quote.author else 'Lao Tzu' }}</cite>
      </article>

      <article class="card widget-card weather-widget">
        <div class="widget-header">
          <i class="ph {{ weather.icon if weather.icon else 'ph-cloud-sun' }}" aria-hidden="true"></i>
          <span class="widget-label">Weather · {{ weather.city if weather.city else 'Pietarsaari' }}</span>
        </div>
        <div class="weather-info">
          <span class="weather-temp">{{ weather.temp if weather.temp else '--°C' }}</span>
          <span class="weather-desc">{{ weather.desc if weather.desc else 'Partly cloudy' }}</span>
        </div>
      </article>
    </div>
  </section>
</main>
</body>
</html>
