<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title>DreamQuest</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

<main>

  <header class="home-header">
    <small>DreamQuest</small>

    <h1>Welcome home</h1>

    <p class="intro">
      Applications and services on DreamQuest.
    </p>
  </header>


  <h2>Applications</h2>

  <section class="grid app-grid">

    <a class="card app-card" href="https://activus.dreamquest/">
      <div>
        <strong>Activus</strong>
        <span class="app-description">
          Activity tracking
        </span>
      </div>

      <span class="open-app">Open →</span>
    </a>


    <a class="card app-card" href="https://foodz.dreamquest/">
      <div>
        <strong>Foodz</strong>
        <span class="app-description">
          Food application
        </span>
      </div>

      <span class="open-app">Open →</span>
    </a>


    <a class="card app-card" href="/proverbs/">
      <div>
        <strong>Proverbs</strong>
        <span class="app-description">
          Proverbs
        </span>
      </div>

      <span class="open-app">Open →</span>
    </a>


    <a class="card app-card" href="http://dreamquest:2283/">
      <div>
        <strong>Immich</strong>
        <span class="app-description">
          Photos
        </span>
      </div>

      <span class="open-app">Open →</span>
    </a>


    <a class="card app-card" href="http://dreamquest:8096/">
      <div>
        <strong>Jellyfin</strong>
        <span class="app-description">
          Movies and media
        </span>
      </div>

      <span class="open-app">Open →</span>
    </a>

  </section>

  <h2>Today</h2>

  <section class="grid widgets">

    <article class="card">
      Quote widget
    </article>

    <article class="card">
      Weather widget
    </article>

  </section>


  <section class="home-actions">

    <a href="/status" class="status-link">
      DreamQuest status →
    </a>

  </section>

</main>

</body>
</html>